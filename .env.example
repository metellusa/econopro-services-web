# Supabase (required for portals / project tracking)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: used only in local scripts / CI with elevated privileges.
# Never expose this in the Vite client bundle.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth redirect base (local or production site URL)
VITE_APP_URL=http://localhost:5173

# Notifications
# development = console/log only (default for local)
# production = call Netlify function + real providers
VITE_NOTIFICATIONS_MODE=development
# VITE_NOTIFICATION_FUNCTION_URL=/.netlify/functions/send-notification

# Netlify function runtime only (never VITE_*):
# NOTIFICATIONS_MODE=development
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=EconoPro Services <updates@yourdomain.com>
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
