# Supabase (required for portals / project tracking)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: used only in local scripts / CI with elevated privileges.
# Never expose this in the Vite client bundle.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth redirect base (local or production site URL)
VITE_APP_URL=http://localhost:5173
